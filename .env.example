APP_NAME="ORWeMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Standard MySQL port. The local Laragon instance in this project uses 3308.
DB_PORT=3306
DB_DATABASE=orwems
DB_USERNAME=root
DB_PASSWORD=

# Session security (Phase 3A)
# The session driver is `database`, so the session payload is written to the
# `sessions` table. ORWeMS sessions carry staff identity, so the payload is
# encrypted at rest rather than stored in the clear.
SESSION_DRIVER=database
SESSION_ENCRYPT=true
# Idle lifetime in minutes. ORWeMS deliberately offers no "remember me"
# option, so an unattended workstation does not stay signed in.
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
# Never expose the session cookie to JavaScript, and keep it off cross-site posts.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Set to true on the production deployment, which must be served over HTTPS.
# Left unset locally so plain-HTTP development on http://localhost keeps working.
# SESSION_SECURE_COOKIE=true
# Expire the session when the browser closes.
# SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ORWeMS domain configuration (Phase 2)
# Prefix used for stable internal beneficiary references, e.g. WICHOV-000001.
ORWEMS_BENEFICIARY_PREFIX=WICHOV
# Prefix used for household codes, e.g. HH-XXXXXXXXXX.
ORWEMS_HOUSEHOLD_PREFIX=HH

# Authentication (Phase 3A)
# ORWeMS signs users in with their email address, which is unique in the
# `users` table; there is no separate username. These values feed config/auth.php.
AUTH_GUARD=web
AUTH_MODEL="App\Models\User"
AUTH_PASSWORD_BROKER=users
# Minutes a password reset link stays valid. Keep short: the link is a
# single-use, time-limited credential.
AUTH_PASSWORD_RESET_EXPIRE=60
# Seconds a user must wait before another reset link is generated.
AUTH_PASSWORD_RESET_THROTTLE=60
# Hours before a password confirmation prompt expires (used when a sensitive
# action is added in a later phase).
AUTH_PASSWORD_TIMEOUT=10800

# ---------------------------------------------------------------------------
# Security hardening (Phase 3D)
# ---------------------------------------------------------------------------
# All values below default to the safe choice for LOCAL HTTP DEVELOPMENT. The
# production deployment must set them in its own .env — which is never
# committed. See docs/PHASE3D_SECURITY_HARDENING.md for the full checklist.

# Redirect plain-HTTP requests to HTTPS. Leave false locally so
# http://localhost keeps working. Set true in production, behind a TLS
# terminator that forwards X-Forwarded-Proto.
ORWEMS_FORCE_HTTPS=false

# Strict-Transport-Security. Only enable once the site is genuinely served
# over HTTPS — HSTS pins browsers to https:// for `max-age` seconds and will
# otherwise lock operators out of a plain-HTTP deployment.
ORWEMS_HSTS_ENABLED=false
ORWEMS_HSTS_MAX_AGE=31536000
ORWEMS_HSTS_PRELOAD=false

# Content-Security-Policy on every response. Report-only mode evaluates and
# reports the policy without blocking, which is the safe way to roll out a
# tightened policy.
ORWEMS_CSP_ENABLED=true
ORWEMS_CSP_REPORT_ONLY=false

# Password expiry. Off by default: enabling it is an operational policy
# decision, not a code deployment. When on, a password expires N days after
# the last change; accounts with no recorded change are grandfathered.
ORWEMS_PASSWORD_EXPIRY_ENABLED=false
ORWEMS_PASSWORD_EXPIRY_DAYS=180

# Second factor (2FA). NOT IMPLEMENTED — this flag exists so the switch is
# visible and testable, and nothing honours it yet. Leave false. Enabling it
# would not activate 2FA; read the Phase 3D document before touching it.
ORWEMS_TWO_FACTOR_ENABLED=false
